# Existing local database
DB_USER=martech_user
DB_PASSWORD=martech_password
DB_HOST=localhost
DB_PORT=3307
DB_NAME=martech_automation
APP_PORT=5001

# Keep test mode until you deliberately connect real providers.
INTEGRATION_MODE=test
HTTP_TIMEOUT=10

# HubSpot (leave blank in test mode)
HUBSPOT_ACCESS_TOKEN=

# Resend (leave blank in test mode)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SALES_NOTIFICATION_TO=

# Inbound webhook security
WEBHOOK_SECRET=replace-with-a-long-random-secret
